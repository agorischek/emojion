{
  "name": "emj",
  "version": "0.1.0",
  "description": "Emoji Object Notation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agorischek/emojion.git"
  },
  "author": {
    "name": "Alex Gorischek",
    "email": "alex.gorischek@gmail.com",
    "url": "https://github.com/agorischek/emojion#readme"
  },
  "keywords": [
    "object notation"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "scripts": {
    "clean": "rimraf lib && rimraf coverage",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,cjs}\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.{ts,cjs}\" README.md",
    "lint": "eslint src/**/*.ts",
    "prebuild": "npm run clean && npm run format:check && npm run lint && echo Using TypeScript && tsc --version",
    "build": "npm run build:lib && npm run build:bundle",
    "build:bundle": "npm run rollup",
    "build:lib": "tsc --pretty",
    "start": "npm run build && npm run test",
    "test": "vitest run --allowOnly=false",
    "test:consumer": "node test/consumer-smoke.cjs .",
    "coverage": "vitest run --coverage",
    "update": "ncu -u && npm i && npm test",
    "rollup": "rollup --config rollup.config.mjs",
    "watch": "npm run build -- --watch",
    "watch:test": "vitest",
    "bench": "npm run build:lib && node --expose-gc bench/index.mjs"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "mitata": "^1.0.34",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.0",
    "rimraf": "^6.1.4",
    "rollup": "^4.68.2",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=10.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
